      "type": "string"
    },
    {
      "name": "produced_at",
      "type": "string"
    },
    {
      "name": "simulation_time_us",
      "type": "long"
    },
    {
      "name": "source_sequence",
      "type": "long"
    },
    {
      "name": "track_version",
      "type": "string"
    },
    {
      "name": "rules_version",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
