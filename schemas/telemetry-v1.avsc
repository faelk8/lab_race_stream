{
  "type": "record",
  "name": "TelemetryEvent",
  "namespace": "io.racestream.telemetry.v1",
  "doc": "Version 1 telemetry event emitted by one simulated car.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string"},
    {"name": "schema_version", "type": "int"},
    {"name": "event_time", "type": "string"},
    {"name": "produced_at", "type": "string"},
    {"name": "race_id", "type": "string"},
    {"name": "car_id", "type": "string"},
    {"name": "driver_id", "type": "string"},
    {"name": "speed_kmh", "type": "double"},
    {"name": "gear", "type": "int"},
    {"name": "rpm", "type": "int"},
    {"name": "fuel_kg", "type": "double"},
    {"name": "car_weight_kg", "type": "double"},
    {"name": "lap", "type": "int"},
    {"name": "sector", "type": "int"},
    {"name": "lap_distance_m", "type": "double"},
    {"name": "track_progress", "type": "double"},
    {"name": "race_position", "type": "int"},
    {"name": "throttle", "type": "double"},
    {"name": "brake", "type": "double"},
    {"name": "tire_compound", "type": "string"},
    {"name": "tire_age_laps", "type": "int"},
    {"name": "pit_status", "type": "string"}
  ]
}