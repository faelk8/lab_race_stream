# Copie para .env.prod e substitua os valores antes de iniciar os serviços.
# Use senhas aleatórias alfanuméricas de pelo menos 32 caracteres para evitar
# caracteres que precisariam de codificação nas URLs PostgreSQL do Compose.
POSTGRES_DB=racestream
POSTGRES_USER=racestream
POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_ALEATORIO_ALFANUMERICO
MINIO_ROOT_USER=racestream_admin
MINIO_ROOT_PASSWORD=SUBSTITUA_POR_SEGREDO_ALEATORIO_ALFANUMERICO
MINIO_BUCKET=racestream
RACE_DOMAIN=corridas.exemplo.com
RACE_BASIC_AUTH_USER=operador
RACE_BASIC_AUTH_HASH=SUBSTITUA_POR_HASH_BCRYPT_DO_CADDY
